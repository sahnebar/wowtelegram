{
  "name": "azeroth-relay",
  "version": "0.1.1",
  "description": "Ein Telegram-Overlay für World of Warcraft Retail und Forever auf Windows und macOS.",
  "productName": "Azeroth Relay",
  "author": "Azeroth Relay contributors",
  "license": "MIT",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir",
    "build:mac": "electron-builder --mac dmg zip --arm64 --x64",
    "build:win": "electron-builder --win nsis --x64"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "teleproto": "1.233.0"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "playwright": "1.65.1"
  },
  "build": {
    "appId": "de.azerothrelay.desktop",
    "productName": "Azeroth Relay",
    "asar": true,
    "asarUnpack": [
      "src/watcher-mac.js",
      "src/watcher-windows.ps1"
    ],
    "directories": {
      "output": "release/0.1.1",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "minimumSystemVersion": "13.0.0"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "Azeroth-Relay-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
